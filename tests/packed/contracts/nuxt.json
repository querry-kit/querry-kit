{
  "manifest": {
    "name": "@querry-kit/nuxt",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "license": "MIT",
    "sideEffects": false,
    "engines": {
      "node": ">=26.13.0"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      },
      "./api": {
        "types": "./dist/api.d.ts",
        "import": "./dist/api.js",
        "require": "./dist/api.cjs",
        "default": "./dist/api.js"
      },
      "./table": {
        "types": "./dist/table.d.ts",
        "import": "./dist/table.js",
        "require": "./dist/table.cjs",
        "default": "./dist/table.js"
      },
      "./autocomplete": {
        "types": "./dist/autocomplete.d.ts",
        "import": "./dist/autocomplete.js",
        "require": "./dist/autocomplete.cjs",
        "default": "./dist/autocomplete.js"
      },
      "./types": {
        "types": "./dist/types.d.ts",
        "import": "./dist/types.js",
        "require": "./dist/types.cjs",
        "default": "./dist/types.js"
      },
      "./utils": {
        "types": "./dist/utils.d.ts",
        "import": "./dist/utils.js",
        "require": "./dist/utils.cjs",
        "default": "./dist/utils.js"
      }
    },
    "peerDependencies": {
      "@vueuse/core": "^14.3.0 || ^15.0.0",
      "@vueuse/router": "^14.3.0 || ^15.0.0",
      "vue": "^3.5.40",
      "vue-router": "^5.2.0"
    },
    "publishConfig": {
      "access": "public"
    }
  },
  "requiredFiles": [
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "incidental": [
    "^dist/chunk-[A-Z0-9]{8}\\.(?:js|cjs)(?:\\.map)?$",
    "^dist/[a-z][a-z0-9.-]*-[A-Za-z0-9_-]{8}\\.d\\.(?:ts|cts)$"
  ]
}
