{
  "name": "querry-kit-workboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "sources:build": "pnpm -w build:packages",
    "sources:check": "node scripts/check-querry-kit-sources.mjs",
    "dev": "pnpm --filter @workboard/contracts build && pnpm --parallel --filter @workboard/api --filter @workboard/app dev",
    "build": "pnpm sources:build && pnpm --filter @workboard/contracts build && pnpm --filter @workboard/api build && pnpm --filter @workboard/app build",
    "typecheck": "pnpm --filter @workboard/contracts typecheck && pnpm --filter @workboard/api typecheck && pnpm --filter @workboard/app typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format:check": "node scripts/format.mjs",
    "format:fix": "node scripts/format.mjs --write",
    "test": "pnpm test:api && pnpm test:web",
    "test:api": "bash scripts/test-api.sh",
    "test:web": "pnpm --filter @workboard/app exec playwright test --config playwright.config.ts",
    "test:compose": "bash scripts/test-compose.sh"
  }
}
