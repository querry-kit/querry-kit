{
  "name": "@querry-kit/landing-page",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.9",
  "scripts": {
    "docs:dev": "pnpm --dir apps/docs dev",
    "docs:lint": "pnpm --dir apps/docs lint",
    "docs:typecheck": "pnpm --dir apps/docs typecheck",
    "docs:build": "pnpm --dir apps/docs build",
    "docs:preview": "pnpm --dir apps/docs preview",
    "docs:test": "pnpm --dir apps/docs test",
    "dev": "pnpm docs:dev",
    "build": "pnpm build:packages && pnpm examples:build && pnpm docs:build",
    "preview": "pnpm docs:preview",
    "examples:dev": "pnpm --dir examples/workboard dev",
    "examples:check": "pnpm --dir examples/workboard typecheck",
    "examples:build": "pnpm --filter @workboard/contracts build && pnpm --filter @workboard/api build && pnpm --filter @workboard/app build",
    "lint": "eslint . --config eslint.config.mjs --max-warnings=0",
    "lint:fix": "eslint . --config eslint.config.mjs --fix",
    "format": "prettier --write .",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only --no-frozen-lockfile",
    "build:packages": "pnpm --filter @querry-kit/nest build && pnpm --filter @querry-kit/nuxt build && pnpm --filter @querry-kit/nuxt-ui build",
    "verify:packages": "node scripts/verify-packages.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "eslint": "^10.15.0",
    "eslint-plugin-jsdoc": "65.5.1",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.73.0",
    "vue-eslint-parser": "10.4.2",
    "yaml": "2.9.1",
    "@changesets/cli": "^3.0.3",
    "eslint-config-prettier": "^10.1.8"
  },
  "version": "0.2.2",
  "engines": {
    "node": ">=26.13.0 <27"
  }
}
