{
  "name": "@querry-kit/landing-page",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.9",
  "scripts": {
    "docs:dev": "pnpm --dir apps/docs dev",
    "docs:lint": "pnpm --dir apps/docs lint",
    "docs:typecheck": "pnpm --dir apps/docs typecheck",
    "docs:build": "pnpm --dir apps/docs build",
    "docs:preview": "pnpm --dir apps/docs preview",
    "docs:test": "pnpm --dir apps/docs test",
    "dev": "pnpm docs:dev",
    "build": "pnpm build:packages && pnpm examples:build && pnpm docs:build",
    "preview": "pnpm docs:preview",
    "examples:dev": "pnpm --filter @workboard/contracts build && pnpm --parallel --filter @workboard/api --filter @workboard/app dev",
    "examples:check": "pnpm --filter @workboard/contracts typecheck && pnpm --filter @workboard/api typecheck && pnpm --filter @workboard/app typecheck",
    "examples:build": "pnpm --filter @workboard/contracts build && pnpm --filter @workboard/api build && pnpm --filter @workboard/app build",
    "lint": "eslint scripts tests/packed --max-warnings=0 && pnpm -r --if-present lint && pnpm examples:lint",
    "lint:fix": "eslint scripts tests/packed --fix && pnpm -r --if-present lint:fix && pnpm examples:lint:fix",
    "format": "prettier --write .",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only --no-frozen-lockfile",
    "build:packages": "pnpm --filter @querry-kit/nest build && pnpm --filter @querry-kit/nuxt build && pnpm --filter @querry-kit/nuxt-ui build",
    "verify:packages": "node scripts/verify-packages.mjs",
    "verify:release-plan": "node scripts/release/rehearse.mjs",
    "examples:sources:check": "node examples/workboard/scripts/check-querry-kit-sources.mjs",
    "examples:lint": "cd examples/workboard && eslint . --max-warnings 0",
    "examples:lint:fix": "cd examples/workboard && eslint . --fix --max-warnings 0",
    "examples:format:check": "cd examples/workboard && node scripts/format.mjs",
    "examples:format:fix": "cd examples/workboard && node scripts/format.mjs --write",
    "examples:test:api": "bash examples/workboard/scripts/test-api.sh",
    "examples:test:compose": "bash examples/workboard/scripts/test-compose.sh",
    "examples:test:web": "pnpm --filter @workboard/app exec playwright test --config playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "eslint": "^10.15.0",
    "eslint-plugin-jsdoc": "65.5.1",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.73.0",
    "vue-eslint-parser": "10.4.2",
    "yaml": "2.9.1",
    "@changesets/cli": "^3.0.3",
    "eslint-config-prettier": "^10.1.8"
  },
  "version": "0.2.2",
  "engines": {
    "node": ">=26.13.0 <27"
  }
}
